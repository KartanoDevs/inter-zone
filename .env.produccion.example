# Copiar a `.env` en la raíz del repo (Compose lo lee solo) y rellenar.
# `.env` NUNCA se commitea: comprueba que /.env está en .gitignore antes de rellenarlo.
#   cp .env.produccion.example .env

# --- Entorno -------------------------------------------------------------------------
# 'local' hace que ./deploy.sh añada docker-compose.local.yml (publica el puerto de `web`
# y usa una red de proxy falsa, porque en tu máquina no existe la real de Nginx Proxy
# Manager). Cualquier otro valor, o dejarlo así, es producción. Si usas `docker compose`
# directamente en vez de ./deploy.sh, esta variable no hace nada por sí sola: tienes que
# añadir tú el -f docker-compose.local.yml.
ENTORNO=produccion

# --- Base de datos -----------------------------------------------------------------
# Credenciales del Postgres de ESTE despliegue. No reutilizar las de desarrollo
# (interzone/interzone, públicas en server/docker-compose.yml) ni las de inter_auu_db.
POSTGRES_USER=inter_admin
POSTGRES_PASSWORD=
POSTGRES_DB=interzone

# --- Aplicación --------------------------------------------------------------------
# Origen público completo, con esquema y sin barra final. Va a ORIGEN_PERMITIDO del
# servidor (cabecera CORS, hoy inerte porque todo es mismo origen). Ej.: https://interzone.tudominio.com
ORIGEN_PUBLICO=

# 'true' añade `; Secure` a la cookie de sesión. Déjalo en 'true' salvo que estés probando
# sin HTTPS: con 'true' y acceso por http, el navegador tira la cookie y nadie puede entrar.
COOKIE_SEGURA=true

# Proxies de confianza delante del servidor. Con el despliegue estándar (nginx de `web` +
# Nginx Proxy Manager) son 2. El limitador de intentos de las rutas de credenciales cuenta la
# IP real con este número; si te sobra o falta un proxy, ajústalo.
SALTOS_PROXY=2

# Correo que se invita como admin la primera vez que se ejecuta la semilla. Esa persona crea
# su cuenta por el registro normal; su contraseña nunca vive aquí.
ADMIN_EMAIL_INICIAL=

# --- Proxy inverso del host ---------------------------------------------------------
# Red de Docker de Nginx Proxy Manager, ya existente en el servidor. No hace falta tocar
# esto salvo que el nombre real difiera de "nginx-proxy-network".
RED_PROXY=nginx-proxy-network

# --- Identidad del entorno (ADR 0044) ------------------------------------------------
# InterZone se despliega dos veces en el mismo servidor: producción y desarrollo, cada una
# con su clon del repo y su propio .env. Este bloque distingue este despliegue del otro.
# No confundir con ENTORNO de arriba: ENTORNO decide qué ficheros de Compose usa deploy.sh
# (local/producción); ENTORNO_APP decide el aspecto de la app compilada (manifiesto PWA,
# aviso en la interfaz, robots.txt).

# El proyecto Compose: prefijo de contenedores y volúmenes. EN PRODUCCIÓN DEBE SEGUIR
# SIENDO "interzone" — es el nombre del que sale el volumen interzone_interzone-datos.
# Cambiarlo aquí crea un volumen nuevo y vacío: la base de datos "desaparece".
PROYECTO_COMPOSE=interzone

# Alias de `web` en la red del proxy: es el "Forward Hostname" que se escribe en el Proxy
# Host de Nginx Proxy Manager. Debe ser distinto en cada despliegue, o el proxy reparte
# tráfico al azar entre los dos.
ALIAS_WEB=interzone-web

# 'produccion' o 'desarrollo'. Ver el comentario de arriba.
ENTORNO_APP=produccion

# Rama que trae y despliega deploy-servidor.sh en este clon.
RAMA_DESPLIEGUE=main

# 'si' o 'no'. Solo el clon de producción toma copias de seguridad (docs/05_Copias_de_Seguridad.md).
# El de desarrollo no guarda nada que no se pueda recrear con `npm run seed:prod`.
COPIAS_DE_SEGURIDAD=si

# 'no' en producción, siempre: `seed:pruebas:prod` (ADR 0045) siembra sistemas de ejemplo y una
# cuenta con contraseña pública — solo tiene sentido en el clon de desarrollo, desechable.
DATOS_DE_PRUEBA=no
