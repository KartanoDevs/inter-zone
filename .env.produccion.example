# Copiar a `.env` en la raíz del repo (Compose lo lee solo) y rellenar.
# `.env` NUNCA se commitea: comprueba que /.env está en .gitignore antes de rellenarlo.
#   cp .env.produccion.example .env

# --- Base de datos -----------------------------------------------------------------
# Credenciales del Postgres de ESTE despliegue. No reutilizar las de desarrollo
# (interzone/interzone, públicas en server/docker-compose.yml) ni las de inter_auu_db.
POSTGRES_USER=interzone
POSTGRES_PASSWORD=
POSTGRES_DB=interzone

# --- Aplicación --------------------------------------------------------------------
# Origen público completo, con esquema y sin barra final. Va a ORIGEN_PERMITIDO del
# servidor (cabecera CORS, hoy inerte porque todo es mismo origen). Ej.: https://interzone.tudominio.com
ORIGEN_PUBLICO=

# 'true' añade `; Secure` a la cookie de sesión. Déjalo en 'true' salvo que estés probando
# sin HTTPS: con 'true' y acceso por http, el navegador tira la cookie y nadie puede entrar.
COOKIE_SEGURA=true

# Correo que se invita como admin la primera vez que se ejecuta la semilla. Esa persona crea
# su cuenta por el registro normal; su contraseña nunca vive aquí.
ADMIN_EMAIL_INICIAL=

# --- Proxy inverso del host ---------------------------------------------------------
# Red de Docker de Nginx Proxy Manager, ya existente en el servidor. No hace falta tocar
# esto salvo que el nombre real difiera de "nginx-proxy-network".
RED_PROXY=nginx-proxy-network
