# Frontend: Angular compilado y servido por nginx. Contexto de build = raíz del repo.
# syntax=docker/dockerfile:1

FROM node:22-bookworm-slim AS build
WORKDIR /app

# Capa de dependencias aparte: solo se reconstruye cuando cambia el lockfile.
# `--ignore-scripts`: en un build de imagen no se ejecutan scripts de ciclo de vida (ni de las
# dependencias ni el `prepare` del proyecto, que instala el hook de git y aquí no hay `.git`).
COPY package.json package-lock.json ./
RUN npm ci --ignore-scripts

# Solo lo que el builder de Angular mira. Enumerado en vez de `COPY . .` para que un cambio
# en server/ o en docs/ no invalide esta capa.
COPY angular.json tsconfig.json tsconfig.app.json ./
COPY public ./public
COPY src ./src

# `npm run build` ya es producción: angular.json tiene defaultConfiguration production,
# con outputHashing "all". No hace falta pasar --configuration.
RUN npm run build

# ---

FROM nginx:alpine AS final

# Sustituye el default.conf de la imagen base (que sirve la página de bienvenida de nginx).
COPY nginx.conf /etc/nginx/conf.d/default.conf

# El builder de Angular escribe en dist/<proyecto>/browser/ (no hay outputPath explícito).
COPY --from=build /app/dist/interzone/browser /usr/share/nginx/html

EXPOSE 80
