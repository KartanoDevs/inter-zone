# Frontend: Angular compilado y servido por nginx. Contexto de build = raíz del repo.
# syntax=docker/dockerfile:1

FROM node:22-bookworm-slim AS build
WORKDIR /app

# 'produccion' o 'desarrollo' (ADR 0044). Decide el manifiesto PWA, el <title>, el aviso en la
# interfaz (por ENTORNO_APP vía angular.json "define") y si se sirve un robots.txt que bloquea
# la indexación. docker-compose.prod.yml lo pasa desde la variable de entorno del mismo nombre.
ARG ENTORNO_APP=produccion

# Capa de dependencias aparte: solo se reconstruye cuando cambia el lockfile.
# `--ignore-scripts`: en un build de imagen no se ejecutan scripts de ciclo de vida (ni de las
# dependencias ni el `prepare` del proyecto, que instala el hook de git y aquí no hay `.git`).
COPY package.json package-lock.json ./
RUN npm ci --ignore-scripts

# Solo lo que el builder de Angular mira. Enumerado en vez de `COPY . .` para que un cambio
# en server/ o en docs/ no invalide esta capa.
COPY angular.json tsconfig.json tsconfig.app.json ./
COPY public ./public
COPY src ./src

# En desarrollo se retocan el manifiesto y el <title> ANTES de compilar, para que el nombre
# distinto llegue también al bundle (Angular no lee estos ficheros en tiempo de ejecución).
RUN if [ "$ENTORNO_APP" = "desarrollo" ]; then \
      sed -i \
        -e 's/"name": "InterZone"/"name": "InterZone (dev)"/' \
        -e 's/"short_name": "InterZone"/"short_name": "IZ dev"/' \
        public/manifest.webmanifest && \
      sed -i \
        -e 's/<title>InterZone<\/title>/<title>InterZone (dev)<\/title>/' \
        -e 's/content="InterZone" \/>\s*$/content="InterZone (dev)" \/>/' \
        -e 's#</head>#  <meta name="robots" content="noindex, nofollow" />\n  </head>#' \
        src/index.html; \
    fi

# `npm run build` ya es producción: angular.json tiene defaultConfiguration production,
# con outputHashing "all". La configuración `entorno-desarrollo` solo cambia el `define`
# ENTORNO_APP que lee src/app/entorno.ts; se combina con "production" (presupuestos y
# optimización iguales en los dos entornos).
RUN if [ "$ENTORNO_APP" = "desarrollo" ]; then \
      npm run build -- --configuration production,entorno-desarrollo; \
    else \
      npm run build; \
    fi

# ---

FROM nginx:alpine AS final

ARG ENTORNO_APP=produccion

# Sustituye el default.conf de la imagen base (que sirve la página de bienvenida de nginx).
COPY nginx.conf /etc/nginx/conf.d/default.conf

# El builder de Angular escribe en dist/<proyecto>/browser/ (no hay outputPath explícito).
COPY --from=build /app/dist/interzone/browser /usr/share/nginx/html

# Bloquea la indexación del sitio de desarrollo. En producción no se escribe robots.txt: sin
# el fichero, nginx sirve su 404 normal y no hay ninguna directiva que respetar u olvidar.
RUN if [ "$ENTORNO_APP" = "desarrollo" ]; then \
      printf 'User-agent: *\nDisallow: /\n' > /usr/share/nginx/html/robots.txt; \
    fi

EXPOSE 80
