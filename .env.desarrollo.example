# Copiar a `.env` en la raíz del CLON DE DESARROLLO (ADR 0044) y rellenar.
# `.env` NUNCA se commitea: comprueba que /.env está en .gitignore antes de rellenarlo.
#   cp .env.desarrollo.example .env
#
# Este es el segundo despliegue de InterZone en el mismo servidor: mismo Docker Compose,
# mismo Nginx Proxy Manager, base de datos y dominio propios y separados de producción.
# Vive en su propio clon del repo (p. ej. ~/projects/interZone/inter-zone-dev), nunca en el
# mismo directorio que producción.

# --- Entorno -------------------------------------------------------------------------
# 'local' hace que ./deploy.sh añada docker-compose.local.yml (publica el puerto de `web`
# y usa una red de proxy falsa, porque en tu máquina no existe la real de Nginx Proxy
# Manager). Cualquier otro valor, o dejarlo así, es producción. Si usas `docker compose`
# directamente en vez de ./deploy.sh, esta variable no hace nada por sí sola: tienes que
# añadir tú el -f docker-compose.local.yml.
ENTORNO=produccion

# --- Base de datos -----------------------------------------------------------------
# Credenciales del Postgres de ESTE despliegue. USA UNA CONTRASEÑA DISTINTA A LA DE
# PRODUCCIÓN: son bases de datos totalmente separadas (volúmenes distintos, por
# PROYECTO_COMPOSE más abajo), y no hay ningún motivo para compartir la credencial.
POSTGRES_USER=inter_admin
POSTGRES_PASSWORD=
POSTGRES_DB=interzone

# --- Aplicación --------------------------------------------------------------------
# Origen público completo, con esquema y sin barra final.
ORIGEN_PUBLICO=https://devcvinterzone.duckdns.org

# 'true' añade `; Secure` a la cookie de sesión. Déjalo en 'true' salvo que estés probando
# sin HTTPS: con 'true' y acceso por http, el navegador tira la cookie y nadie puede entrar.
COOKIE_SEGURA=true

# Proxies de confianza delante del servidor. Con el despliegue estándar (nginx de `web` +
# Nginx Proxy Manager) son 2. El limitador de intentos de las rutas de credenciales cuenta la
# IP real con este número; si te sobra o falta un proxy, ajústalo.
SALTOS_PROXY=2

# Correo que se invita como admin la primera vez que se ejecuta la semilla. Esa persona crea
# su cuenta por el registro normal; su contraseña nunca vive aquí.
ADMIN_EMAIL_INICIAL=

# --- Proxy inverso del host ---------------------------------------------------------
# Red de Docker de Nginx Proxy Manager, ya existente en el servidor. Es la MISMA red que usa
# el clon de producción: un único Nginx Proxy Manager reparte los dos dominios.
RED_PROXY=nginx-proxy-network

# --- Identidad del entorno (ADR 0044) ------------------------------------------------
# No confundir con ENTORNO de arriba: ENTORNO decide qué ficheros de Compose usa deploy.sh
# (local/producción); ENTORNO_APP decide el aspecto de la app compilada (manifiesto PWA,
# aviso en la interfaz, robots.txt).

# El proyecto Compose: prefijo de contenedores y volúmenes. Distinto del de producción
# ("interzone") para que cada uno tenga su propio volumen de base de datos.
PROYECTO_COMPOSE=interzone-dev

# Alias de `web` en la red del proxy: es el "Forward Hostname" que se escribe en el Proxy
# Host de Nginx Proxy Manager para devcvinterzone.duckdns.org. Distinto del de producción.
ALIAS_WEB=interzone-dev-web

# 'desarrollo': manifiesto PWA con nombre propio ("InterZone (dev)"), aviso "Entorno de
# desarrollo" en la interfaz y robots.txt que bloquea la indexación.
ENTORNO_APP=desarrollo

# Rama que trae y despliega deploy-servidor.sh en este clon.
RAMA_DESPLIEGUE=develop

# 'no': este clon no toma copias de seguridad (docs/05_Copias_de_Seguridad.md). No guarda
# datos reales de nadie; si algo se rompe, se reconstruye desde cero con `seed:prod`.
COPIAS_DE_SEGURIDAD=no
