// Espejo de docs/modelo-de-datos.md. Las seis tablas de voleibol (equipo, jugador, sistema,
// sistema_rotacion, formacion, colocacion) llegaron con la spec 033. Las de acceso (usuario,
// lista_blanca, membresia) llegan con la spec 035, en una migración nueva que no toca esas
// seis; añade además `sesion`, sin diseñar en el documento original (ver su §9, nota final).
//
// Los CHECK y la función celdas_validas() no se declaran aquí: Prisma no los expresa en su
// lenguaje de esquema (docs/modelo-de-datos.md §6, "Nota sobre Prisma"). Van a mano en
// prisma/migrations/.../migration.sql.

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum tipo_sistema {
  recepcion
  defensa
}

enum rol_jugador {
  colocador
  receptor
  central
  opuesto
  libero
}

/// El caso del colocador rival (spec 038): sustituye a la rotación como eje de navegación en
/// defensa. Determina qué situaciones de ataque son posibles (situacion_defensa).
enum caso_colocador {
  delantero
  trasero
}

/// Contra qué ataca el rival, en defensa (spec 038): la postura de base, o una de las zonas de
/// su ataque. Sustituye a `via_ataque` — el ataque por 1 solo existe cuando el colocador rival
/// es delantero, y `via_ataque` no lo distinguía porque no dependía del caso.
enum situacion_defensa {
  inicial
  z4
  z3
  z2
  z1
  pipe
}

enum estado_sistema {
  borrador
  validado
}

/// Rol de acceso (spec 035): admin es global (no lleva membresia); entrenador y usuario se
/// acotan por equipo, vía `membresia`. Distinto de `rol_jugador` (docs/modelo-de-datos.md,
/// "aviso de vocabulario").
enum rol_acceso {
  admin
  entrenador
  usuario
}

/// Los tres tipos de examen (spec 012): por posición (un único titular), por línea (los tres de
/// su línea) o por sistema completo (los seis, en las seis rotaciones).
enum tipo_examen {
  puesto
  linea
  sistema
}

model equipo {
  id     String @id @default(uuid()) @db.Uuid
  clave  String @unique
  nombre String

  sistemas      sistema[]
  membresias    membresia[]
  lista_blanca  lista_blanca[]
}

/// Cuenta con contraseña (spec 035). `es_admin` es global; el resto del rol vive en
/// `membresia`, acotado por equipo.
model usuario {
  id                String        @id @default(uuid()) @db.Uuid
  email             String        @unique
  contrasena_hash   String
  es_admin          Boolean       @default(false)
  nombre            String?
  posicion_favorita rol_jugador?
  dorsal            Int?          @db.SmallInt
  creado_en         DateTime      @default(now()) @db.Timestamptz
  actualizado_en    DateTime      @default(now()) @db.Timestamptz
  ultimo_acceso_en  DateTime?     @db.Timestamptz

  membresias          membresia[]
  sesiones            sesion[]
  invitaciones_hechas lista_blanca[]
  sistemas_validados  sistema[]
  insignias           insignia_examen[]
}

/// La única puerta de entrada (spec 035, ADR 0039): sin una fila aquí no se crea cuenta. Fija
/// el rol y el equipo con el que nace. `equipo_id` nulo = ambos equipos.
model lista_blanca {
  email        String      @id
  rol          rol_acceso  @default(usuario)
  equipo_id    String?     @db.Uuid
  invitado_por String?     @db.Uuid
  creado_en    DateTime    @default(now()) @db.Timestamptz
  usada_en     DateTime?   @db.Timestamptz

  equipo    equipo?  @relation(fields: [equipo_id], references: [id], onDelete: Restrict)
  invitador usuario? @relation(fields: [invitado_por], references: [id], onDelete: SetNull)
}

/// Permiso de una cuenta sobre un equipo concreto (spec 035): `admin` no aparece aquí porque
/// no está acotado a ningún equipo.
model membresia {
  usuario_id String     @db.Uuid
  equipo_id  String     @db.Uuid
  rol        rol_acceso

  usuario usuario @relation(fields: [usuario_id], references: [id], onDelete: Cascade)
  equipo  equipo  @relation(fields: [equipo_id], references: [id], onDelete: Cascade)

  @@id([usuario_id, equipo_id])
}

/// Sesión de acceso (spec 035): testigo opaco, guardado solo como huella (`testigo_hash`) —
/// nunca el valor que viaja en la cookie del navegador.
model sesion {
  id           String   @id @default(uuid()) @db.Uuid
  usuario_id   String   @db.Uuid
  testigo_hash String   @unique
  creada_en    DateTime @default(now()) @db.Timestamptz
  expira_en    DateTime @db.Timestamptz

  usuario usuario @relation(fields: [usuario_id], references: [id], onDelete: Cascade)
}

/// Catálogo fijo de siete huecos del dominio, no personas (docs/modelo-de-datos.md §5).
model jugador {
  id          String       @id
  rol         rol_jugador
  indice      Int?         @db.SmallInt
  orden_saque Int?         @db.SmallInt

  colocaciones       colocacion[]
  sustituye_en       sistema_rotacion[]
}

model sistema {
  id             String         @id @default(uuid()) @db.Uuid
  equipo_id      String         @db.Uuid
  tipo           tipo_sistema
  nombre         String
  descripcion    String?
  estado         estado_sistema @default(borrador)
  /// Quién lo validó y cuándo (spec 051). Ambos nulos mientras esté en borrador — CHECK
  /// sistema_validado_con_fecha a mano, Prisma no expresa esa condición conjunta.
  validado_por   String?        @db.Uuid
  validado_en    DateTime?      @db.Timestamptz
  creado_en      DateTime       @default(now()) @db.Timestamptz
  actualizado_en DateTime       @default(now()) @db.Timestamptz

  equipo             equipo               @relation(fields: [equipo_id], references: [id], onDelete: Restrict)
  validador          usuario?             @relation(fields: [validado_por], references: [id], onDelete: SetNull)
  rotaciones         sistema_rotacion[]
  formaciones_defensa formacion_defensa[]
  insignias          insignia_examen[]

  @@unique([equipo_id, tipo, nombre])
  @@index([equipo_id, tipo, estado])
}

/// La explicación de conjunto de una rotación y a quién sustituye el líbero en ella — dos cosas
/// en una tabla porque ambas van por (sistema, rotación) (docs/modelo-de-datos.md §5).
model sistema_rotacion {
  sistema_id         String  @db.Uuid
  rotacion           Int     @db.SmallInt
  explicacion        String?
  libero_sustituye_a String?

  sistema  sistema     @relation(fields: [sistema_id], references: [id], onDelete: Cascade)
  jugador  jugador?    @relation(fields: [libero_sustituye_a], references: [id], onDelete: Restrict)
  formaciones formacion[]

  @@id([sistema_id, rotacion])
}

model formacion {
  id         String      @id @default(uuid()) @db.Uuid
  sistema_id String      @db.Uuid
  rotacion   Int         @db.SmallInt

  rotacion_ref sistema_rotacion @relation(fields: [sistema_id, rotacion], references: [sistema_id, rotacion], onDelete: Cascade)
  colocaciones colocacion[]

  @@unique([sistema_id, rotacion])
}

/// Una defensa guardada para un caso de colocador rival, una situación de ataque y un número de
/// bloqueadores (spec 038, ampliado por la 039). Cuelga directamente de `sistema`, no de
/// `sistema_rotacion`: en defensa ya no hay rotación.
model formacion_defensa {
  id           String            @id @default(uuid()) @db.Uuid
  sistema_id   String            @db.Uuid
  caso         caso_colocador
  situacion    situacion_defensa
  bloqueadores Int               @default(0) @db.SmallInt
  explicacion  String?
  /// Retoque manual de la sombra de bloqueo respecto a su posición calculada (spec 040). Ambos
  /// nulos o ambos presentes — CHECK a mano, Prisma no expresa esa condición conjunta.
  sombra_dx    Float?
  sombra_dy    Float?
  /// Punto exacto donde se soltó la ficha "A" del atacante (spec 072). Ambos nulos o ambos
  /// presentes, mismo CHECK a mano que sombra_dx/sombra_dy.
  atacante_x   Float?
  atacante_y   Float?
  /// Punto de la ficha del central rival (spec 073): referencia visual, sin efecto en el
  /// cálculo de la defensa. Ambos nulos o ambos presentes, mismo CHECK a mano.
  central_x    Float?
  central_y    Float?

  sistema      sistema                @relation(fields: [sistema_id], references: [id], onDelete: Cascade)
  colocaciones colocacion_defensa[]

  @@unique([sistema_id, caso, situacion, bloqueadores])
}

/// Un puesto genérico ocupado en una formación de defensa (spec 038): sin jugador, sin
/// rotación — el diagrama coloca por zona física del campo (1..6), no por quién juega.
model colocacion_defensa {
  formacion_id String  @db.Uuid
  puesto       Int     @db.SmallInt
  x            Float
  y            Float
  explicacion  String?
  /// Mismos tres estados que `colocacion.celdas` (docs/modelo-de-datos.md §5).
  celdas       Int[]
  /// Zona de finta (spec 041): campo paralelo a `celdas`, mismos tres estados. Se escribe y se
  /// lee con SQL a mano, igual que `celdas` (ver el comentario de `colocacion.celdas` más abajo).
  celdas_finta Int[]

  formacion formacion_defensa @relation(fields: [formacion_id], references: [id], onDelete: Cascade)

  @@id([formacion_id, puesto])
}

model colocacion {
  formacion_id String  @db.Uuid
  jugador_id   String
  x            Float
  y            Float
  explicacion  String?
  /// Los tres estados de Colocacion.celdas (docs/modelo-de-datos.md §5): null = nunca tocada,
  /// [] = vaciada a propósito, con valores = zona pintada. Prisma no admite "lista opcional"
  /// en su lenguaje de esquema (Int[]? no es válido) y su cliente tipado no deja escribir
  /// null en una columna array aunque la propia columna sí lo permita — así que esta columna
  /// se escribe y se lee con SQL a mano en sistema.repositorio.ts, no con el cliente
  /// generado. Se deja declarada aquí solo para que Prisma conozca la tabla.
  celdas       Int[]

  formacion formacion @relation(fields: [formacion_id], references: [id], onDelete: Cascade)
  jugador   jugador   @relation(fields: [jugador_id], references: [id], onDelete: Restrict)

  @@id([formacion_id, jugador_id])
}

/// Una insignia ganada al examinarse (spec 056): solo el hecho de haberla ganado, nunca la nota
/// ni las colocaciones del intento — ambas son recalculables (specs 012-013) y guardarlas ataría
/// el histórico a la fórmula de puntuación de hoy. `titular_id` es nulo para el tipo `sistema`
/// (coloca a los seis, no examina a uno); obligatorio para `puesto` y `linea` — CHECK a mano,
/// Prisma no expresa esa condición conjunta.
model insignia_examen {
  usuario_id  String      @db.Uuid
  sistema_id  String      @db.Uuid
  tipo        tipo_examen
  titular_id  String      @default("")
  obtenida_en DateTime    @default(now()) @db.Timestamptz

  usuario usuario @relation(fields: [usuario_id], references: [id], onDelete: Cascade)
  sistema sistema @relation(fields: [sistema_id], references: [id], onDelete: Cascade)

  @@id([usuario_id, sistema_id, tipo, titular_id])
}
