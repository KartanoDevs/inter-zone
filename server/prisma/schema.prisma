// Espejo de docs/modelo-de-datos.md — solo las seis tablas que necesita la spec 033
// (equipo, jugador, sistema, sistema_rotacion, formacion, colocacion). Las tres de acceso
// (usuario, lista_blanca, membresia) llegan con la spec 035, en una migración nueva que no
// toca esta.
//
// Los CHECK y la función celdas_validas() no se declaran aquí: Prisma no los expresa en su
// lenguaje de esquema (docs/modelo-de-datos.md §6, "Nota sobre Prisma"). Van a mano en
// prisma/migrations/.../migration.sql.

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum tipo_sistema {
  recepcion
  defensa
}

enum rol_jugador {
  colocador
  receptor
  central
  opuesto
  libero
}

enum via_ataque {
  z4
  z3
  z2
  pipe
}

/// El caso del colocador rival (spec 038): sustituye a la rotación como eje de navegación en
/// defensa. Determina qué situaciones de ataque son posibles (situacion_defensa).
enum caso_colocador {
  delantero
  trasero
}

/// Contra qué ataca el rival, en defensa (spec 038): la postura de base, o una de las zonas de
/// su ataque. Sustituye a `via_ataque` — el ataque por 1 solo existe cuando el colocador rival
/// es delantero, y `via_ataque` no lo distinguía porque no dependía del caso.
enum situacion_defensa {
  inicial
  z4
  z3
  z2
  z1
  pipe
}

enum estado_sistema {
  borrador
  validado
}

model equipo {
  id     String @id @default(uuid()) @db.Uuid
  clave  String @unique
  nombre String

  sistemas sistema[]
}

/// Catálogo fijo de siete huecos del dominio, no personas (docs/modelo-de-datos.md §5).
model jugador {
  id          String       @id
  rol         rol_jugador
  indice      Int?         @db.SmallInt
  orden_saque Int?         @db.SmallInt

  colocaciones       colocacion[]
  sustituye_en       sistema_rotacion[]
}

model sistema {
  id             String         @id @default(uuid()) @db.Uuid
  equipo_id      String         @db.Uuid
  tipo           tipo_sistema
  nombre         String
  descripcion    String?
  estado         estado_sistema @default(borrador)
  creado_en      DateTime       @default(now()) @db.Timestamptz
  actualizado_en DateTime       @default(now()) @db.Timestamptz

  equipo             equipo               @relation(fields: [equipo_id], references: [id], onDelete: Restrict)
  rotaciones         sistema_rotacion[]
  formaciones_defensa formacion_defensa[]

  @@unique([equipo_id, tipo, nombre])
  @@index([equipo_id, tipo, estado])
}

/// La explicación de conjunto de una rotación y a quién sustituye el líbero en ella — dos cosas
/// en una tabla porque ambas van por (sistema, rotación) (docs/modelo-de-datos.md §5).
model sistema_rotacion {
  sistema_id         String  @db.Uuid
  rotacion           Int     @db.SmallInt
  explicacion        String?
  libero_sustituye_a String?

  sistema  sistema     @relation(fields: [sistema_id], references: [id], onDelete: Cascade)
  jugador  jugador?    @relation(fields: [libero_sustituye_a], references: [id], onDelete: Restrict)
  formaciones formacion[]

  @@id([sistema_id, rotacion])
}

model formacion {
  id         String      @id @default(uuid()) @db.Uuid
  sistema_id String      @db.Uuid
  rotacion   Int         @db.SmallInt

  rotacion_ref sistema_rotacion @relation(fields: [sistema_id, rotacion], references: [sistema_id, rotacion], onDelete: Cascade)
  colocaciones colocacion[]

  @@unique([sistema_id, rotacion])
}

/// Una defensa guardada para un caso de colocador rival, una situación de ataque y un número de
/// bloqueadores (spec 038, ampliado por la 039). Cuelga directamente de `sistema`, no de
/// `sistema_rotacion`: en defensa ya no hay rotación.
model formacion_defensa {
  id           String            @id @default(uuid()) @db.Uuid
  sistema_id   String            @db.Uuid
  caso         caso_colocador
  situacion    situacion_defensa
  bloqueadores Int               @default(0) @db.SmallInt
  explicacion  String?
  /// Retoque manual de la sombra de bloqueo respecto a su posición calculada (spec 040). Ambos
  /// nulos o ambos presentes — CHECK a mano, Prisma no expresa esa condición conjunta.
  sombra_dx    Float?
  sombra_dy    Float?

  sistema      sistema                @relation(fields: [sistema_id], references: [id], onDelete: Cascade)
  colocaciones colocacion_defensa[]

  @@unique([sistema_id, caso, situacion, bloqueadores])
}

/// Un puesto genérico ocupado en una formación de defensa (spec 038): sin jugador, sin
/// rotación — el diagrama coloca por zona física del campo (1..6), no por quién juega.
model colocacion_defensa {
  formacion_id String  @db.Uuid
  puesto       Int     @db.SmallInt
  x            Float
  y            Float
  explicacion  String?
  /// Mismos tres estados que `colocacion.celdas` (docs/modelo-de-datos.md §5).
  celdas       Int[]

  formacion formacion_defensa @relation(fields: [formacion_id], references: [id], onDelete: Cascade)

  @@id([formacion_id, puesto])
}

model colocacion {
  formacion_id String  @db.Uuid
  jugador_id   String
  x            Float
  y            Float
  explicacion  String?
  /// Los tres estados de Colocacion.celdas (docs/modelo-de-datos.md §5): null = nunca tocada,
  /// [] = vaciada a propósito, con valores = zona pintada. Prisma no admite "lista opcional"
  /// en su lenguaje de esquema (Int[]? no es válido) y su cliente tipado no deja escribir
  /// null en una columna array aunque la propia columna sí lo permita — así que esta columna
  /// se escribe y se lee con SQL a mano en sistema.repositorio.ts, no con el cliente
  /// generado. Se deja declarada aquí solo para que Prisma conozca la tabla.
  celdas       Int[]

  formacion formacion @relation(fields: [formacion_id], references: [id], onDelete: Cascade)
  jugador   jugador   @relation(fields: [jugador_id], references: [id], onDelete: Restrict)

  @@id([formacion_id, jugador_id])
}
