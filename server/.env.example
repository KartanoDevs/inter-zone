# Copiar a .env (nunca se commitea) para desarrollo local.
# docker-compose.yml levanta un Postgres con estas mismas credenciales.
DATABASE_URL="postgresql://interzone:interzone@localhost:5432/interzone"
PORT=3000
# Origen desde el que el navegador puede llamar a la API (CORS). Por defecto, el puerto de
# desarrollo de Angular.
ORIGEN_PERMITIDO=http://localhost:4200
