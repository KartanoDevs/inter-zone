# See https://docs.github.com/get-started/getting-started-with-git/ignoring-files for more about ignoring files.

# Compiled output
/dist
/tmp
/out-tsc
/bazel-out
*.tsbuildinfo

# Este proyecto es TypeScript puro bajo src/: cualquier .js ahí es emisión accidental
# de `tsc --build` sin `--noEmit` (no hay outDir configurado), nunca código fuente real.
src/**/*.js

# Node — con barra inicial para que solo afecte a la raíz; server/ tiene sus propias entradas
# más abajo (spec 033), porque /node_modules sin más no habría alcanzado server/node_modules.
/node_modules
npm-debug.log
yarn-error.log

# server/ (spec 033): su propio proyecto Node, con su propio node_modules y su cliente Prisma
# generado — ninguno de los dos es código fuente.
server/node_modules
server/generated
server/.env

# `.claude/` es un *junction* de Windows a `.agents/` (que sí está versionado). Sin esta
# entrada, git lo trata como un directorio normal sin seguimiento y un cambio de rama puede
# borrar a través del enlace los ficheros reales de `.agents/` — ya pasó una vez.
/.claude

# IDEs and editors
.idea/
.project
.classpath
.c9/
*.launch
.settings/
*.sublime-workspace

# Visual Studio Code
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
!.vscode/mcp.json
.history/*

# Miscellaneous
/.angular/cache
.sass-cache/
/connect.lock
/coverage
/libpeerconnection.log
testem.log
/typings
__screenshots__/

# System files
.DS_Store
Thumbs.db
